{
  "name": "cgc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run verify:routes",
    "dev": "next dev",
    "dev:fresh": "node scripts/verify-routes.mjs --clean && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:routes": "node scripts/verify-routes.mjs",
    "test:e2e": "playwright test",
    "test:integration": "playwright test -c playwright.integration.config.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2"
  }
}
